{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "enabledMcpjsonServers": ["github", "vercel"],
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx expo lint)",
      "Bash(npx expo-doctor)",
      "Bash(npx expo install:*)",
      "Bash(npx expo export:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  }
}
